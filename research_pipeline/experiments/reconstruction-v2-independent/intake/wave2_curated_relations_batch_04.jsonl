{"id":"rel.wave2.batch04.rank-of-map-finite-free.to.left-module-nonunital","from_formulation":"form.41e3aea7f356bae3.rank-of-map-finite-free","target_meaning":"meaning.wave2.foundation.left-module-nonunital","relation_type":"definition_uses","review_state":"screened","source_phrase":"free modules","editorial_reason":"Maps of finite free modules require general module structures first. The target does not itself supply free modules, exterior powers or the rank condition.","source_locator":"https://stacks.math.columbia.edu/tag/00MR","target_locator":"https://proofwiki.org/wiki/Definition%3AModule_over_Ring","reviewed_by":"assistant_independent_scope_comparison_2026_10_19","human_verified":false}
