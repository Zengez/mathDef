{"id":"rel.wave2.batch04.free-module-resolution.to.left-module-nonunital","from_formulation":"form.788671763be693df.free-module-resolution","target_meaning":"meaning.wave2.foundation.left-module-nonunital","relation_type":"definition_uses","review_state":"screened","source_phrase":"R-module M","editorial_reason":"A free resolution is built from free R-modules and ends in an R-module M; the module scalar action is prior, while free modules and exact complexes remain separately needed.","source_locator":"https://stacks.math.columbia.edu/tag/00LO","target_locator":"https://proofwiki.org/wiki/Definition%3AModule_over_Ring","reviewed_by":"assistant_independent_scope_comparison_2026_10_19","human_verified":false}
