{"id":"rel.wave2.batch06.groupoid-valued-presheaf.to.category-valued-presheaf","from_formulation":"form.f0d993a60533fc99.groupoid-valued-presheaf","target_meaning":"meaning.f7206eb9332b9389.category-valued-presheaf","relation_type":"definition_uses","review_state":"screened","source_phrase":"functor F:C^op→Groupoids","editorial_reason":"A strict groupoid-valued presheaf is a category-valued presheaf whose values are groupoids. Stacks 4.36 and 4.37 use strict functors from C^op and not general pseudofunctors. Re-examine the previously held ambiguity once the proper prerequisite is screened.","source_locator":"https://stacks.math.columbia.edu/tag/0048","target_locator":"https://stacks.math.columbia.edu/tag/02XU","reviewed_by":"assistant_independent_source_specific_review_2026_10_19","human_verified":false}
