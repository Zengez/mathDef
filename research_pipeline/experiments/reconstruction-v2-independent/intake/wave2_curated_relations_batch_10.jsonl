{"id":"rel.wave2.batch10.14","from_formulation":"form.d2b85c43cfbc6c05.finite-type-ring-map","target_meaning":"meaning.wave2.foundation.ring-map-unital","relation_type":"definition_uses","review_state":"screened","source_phrase":"ring map R→S","editorial_reason":"Finite-type ring maps in the Stacks commutative-unital convention require an identity-preserving ring map before finite algebra generation.","source_locator":"https://stacks.math.columbia.edu/tag/00F2","target_locator":"https://proofwiki.org/wiki/Definition%3ARing_Homomorphism","reviewed_by":"assistant_independent_mathematical_source_comparison_2026_10_19","human_verified":false}
