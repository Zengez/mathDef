  "text_overrides": {
    "form.ab260940ea9c523d.connected-component-space": {
      "text": "A connected component of a topological space X is a nonempty connected subset of X that is maximal under inclusion among connected subsets of X.",
      "reason": "Stacks §5.7 explicitly requires connected spaces/subsets to be nonempty. Under mathDef's broader no-separation meaning the empty subset is connected, so make nonemptiness explicit to preserve the Stacks maximal-subset component definition when X is empty.",
      "original_text": "A connected component of a topological space X is a connected subset maximal under inclusion among connected subsets of X.",
      "source_url": "https://stacks.math.columbia.edu/tag/004R",
      "source_assessment_id": "sourceconv.stacks.004R.connected.nonempty.20261027",
      "convention_id": "topology.connected.nonempty",
      "evidence_status": "verified_applies",
      "translation_kind": "paraphrase_scoped_restriction_explicated",
      "audit_note": "The added nonempty condition preserves the empty-space behavior: empty X has no connected components."
    }
  }
